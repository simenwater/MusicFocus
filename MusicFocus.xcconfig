// Local developers can opt in after supplying the optional resources.
MUSICFOCUS_DEFAULT_Debug = NO
MUSICFOCUS_DEFAULT_Release = NO
#include? "MusicFocus.local.xcconfig"
MUSICFOCUS_INCLUDE_HOMR = $(MUSICFOCUS_DEFAULT_$(CONFIGURATION):default=NO)

MUSICFOCUS_HOMR_FLAG = $(MUSICFOCUS_HOMR_FLAG_$(MUSICFOCUS_INCLUDE_HOMR))
MUSICFOCUS_HOMR_FLAG_YES = MUSICFOCUS_HOMR
MUSICFOCUS_HOMR_INPUT = $(MUSICFOCUS_HOMR_INPUT_$(MUSICFOCUS_INCLUDE_HOMR))
MUSICFOCUS_HOMR_INPUT_YES = $(SRCROOT)/Development/ScoreRecognitionModels
MUSICFOCUS_HOMR_INPUT_NO = $(SRCROOT)/MusicFocus.xcconfig
