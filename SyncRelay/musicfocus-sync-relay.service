[Unit]
Description=MusicFocus score sync relay
After=network.target

[Service]
ExecStart=/usr/bin/node /srv/musicfocus-sync-relay/relay.mjs
WorkingDirectory=/srv/musicfocus-sync-relay
Environment=HOST=127.0.0.1 PORT=3840
DynamicUser=yes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
