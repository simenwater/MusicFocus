    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is used to record performance videos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问摄像头来录制演奏视频。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MusicFocus uses the local network and Bluetooth to find a nearby iPad and sync score annotations directly between the two devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MusicFocus 使用本地网络和蓝牙寻找附近的 iPad，在两台设备之间直接同步乐谱批注。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MusicFocus uses the microphone to detect practice sounds and, when you choose Record, save voice notes on your score. Audio notes stay on this device unless you export them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MusicFocus 使用麦克风识别练习声音，并在你选择录音时保存乐谱语音笔记。语音笔记保存在本机，可由你主动导出。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo library access is used to select sheet music images."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要访问相册来选择乐谱图片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
