    "score.smartFingeringHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaten new digits 0–9 and circled digits after a brief pause. Works with pen and monoline, on device. Uncertain marks stay unchanged. Undo restores your handwriting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短暂停笔后，规整新写的 0–9 和圈数字。支持钢笔和单线笔，在本机处理；不确定的笔迹保持原样，撤销可恢复原笔迹。"
          }
        }
      }
    },
    "score.startPractice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start practice"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始练习"
          }
        }
      }
    },
    "score.statistics" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Practice by Score"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按曲目统计"
          }
        }
      }
    },
    "score.statisticsExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displayed time means the score was visible in this app, not eye tracking. Practice time uses sound detection and excludes pauses. Two-page spreads count once. Metronome time does not measure rhythmic accuracy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面显示时长表示乐谱在本应用中可见，不代表视线追踪。练习时长依据声音检测，扣除无声等待与暂停。双页作为一组，只累计一次。节拍器时长不代表节奏准确率。"
          }
        }
      }
    },
    "score.stopPractice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结束"
          }
        }
      }
    },
    "score.sync.actionsHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sync annotations” lets the other iPad choose which copy both keep: yours, or theirs (then yours are replaced and backed up here). “Start live lesson” shows your ink, fingerings and annotation edits on their copy as you write; one direction only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“同步批注”由对方选择两台 iPad 都保留哪一份：你的，或对方的（这时你的批注会被替换，并在本机留备份）。“开始直播上课”让对方的谱子实时显示你写下的笔迹、指法和批注修改，仅单向。"
          }
        }
      }
    },
    "score.sync.backupLive" : {
