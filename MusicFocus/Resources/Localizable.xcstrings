    "score.sync.remotePaywallDisclosure" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is an auto-renewable subscription of %2$@ for %3$@. Payment is charged to your Apple Account when you confirm the purchase. The subscription renews automatically until cancelled: it renews unless cancelled at least 24 hours before the end of the current period, and the renewal is charged within the 24 hours before the period ends. You can manage or cancel it at any time in Settings > [your name] > Subscriptions, or with Manage Subscription above."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@为自动续费订阅，每期 %2$@，价格 %3$@。确认购买后将从你的 Apple 账户扣费。订阅会自动续费，直到你取消：除非在当前周期结束前至少 24 小时取消，否则将自动续订，并在周期结束前 24 小时内扣除续费费用。你可以随时在“设置 > [你的姓名] > 订阅”中，或通过上方的“管理订阅”管理或取消订阅。"
          }
        }
      }
    },
