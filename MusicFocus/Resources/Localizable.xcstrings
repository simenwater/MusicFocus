    "score.annotationHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Apple Pencil to write. In Select mode, drag a note directly, or drag a box from blank paper to select several strokes and move or delete them together. Selection works with a finger or Pencil. Use two fingers to move or zoom the page. Enable Draw with finger only when you want to write with a finger. Imported editable PDF annotations can also be moved, recolored or deleted. Export editable PDF to keep annotations editable. Printed or flattened notes cannot be moved separately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Apple Pencil 书写。在选择工具下，直接拖动笔记；从空白处拖框可选中多笔，再一起移动或删除。手指和 Pencil 都能选择，双指移动或缩放谱面。需要用手指写字时再开启手指绘画。导入的可编辑 PDF 批注也可移动、改色或删除。导出可编辑 PDF 可保留批注；原有印刷内容或已压平的笔记不能单独移动。"
          }
        }
      }
    },
    "score.annotationHelpTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotation help"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标注操作说明"
          }
        }
      }
    },
